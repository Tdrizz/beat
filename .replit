modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 18738
externalPort = 3001

[[ports]]
localPort = 24542
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CRON_SECRET = "db9110b3f18e849ee7cc68c82b5ca871c958b6c6b163937ee3453fca5e6cdd10"

[objectStorage]
defaultBucketID = "replit-objstore-63e5d478-8f45-4179-920b-4de5a4b3512a"
