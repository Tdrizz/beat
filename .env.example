# Glamr environment variables. Copy to `.env` and fill in locally; in hosted
# environments set these in the platform's secret store. Never commit values.

# Core
NODE_ENV=
PORT=
# Pooled connection for the running app
DATABASE_URL=
# Direct (non-pooled) connection for migrations
DATABASE_DIRECT_URL=
PUBLIC_APP_URL=
# Comma-separated full origins, e.g. https://glamr.app,https://www.glamr.app
ALLOWED_ORIGINS=
LOG_LEVEL=
# Reverse-proxy hops in front of the API (default 1). Verify on staging.
TRUST_PROXY_HOPS=
# Set to 1 to run dev seed data on boot in production (default: off).
RUN_SEEDS=

# Frontend build (Vite). BASE_PATH defaults to / once Phase 1 lands.
BASE_PATH=

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Storage (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STORAGE_BUCKET_PUBLIC=
STORAGE_BUCKET_PRIVATE=

# Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Dev only: set to 1 to skip webhook signature checks. Ignored in production.
STRIPE_WEBHOOK_DEV_INSECURE=

# Email
RESEND_API_KEY=
DIGEST_FROM_EMAIL=

# AI
GEMINI_API_KEY=
# Optional overrides; defaults are in lib/integrations-gemini-ai/src/client.ts
GEMINI_CHAT_MODEL=
GEMINI_IMAGE_MODEL=
# Global daily caps on paid AI calls (defaults 2000 / 5000; 0 disables)
AI_DAILY_TRYON_CAP=
AI_DAILY_CHAT_CAP=

# Error monitoring (Sentry); leave blank to disable
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=
VITE_SENTRY_ENVIRONMENT=
# 0-1 share of requests to trace (default 0 = errors only)
SENTRY_TRACES_SAMPLE_RATE=

# Access control
# Guards POST /api/digest/run and POST /api/storage/uploads/cleanup.
# Generate with: openssl rand -hex 32
CRON_SECRET=
# Comma-separated Clerk user IDs
ADMIN_USER_IDS=
CURATOR_USER_IDS=
